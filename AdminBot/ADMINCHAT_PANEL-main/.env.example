# ===== Database =====
POSTGRES_DB=adminchat
POSTGRES_USER=adminchat
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://adminchat:change_me_strong_password@postgres:5432/adminchat

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== JWT Authentication =====
JWT_SECRET_KEY=change_me_random_64_char_string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Telegram Bot =====
# Bot mode: "webhook" for production, "polling" for development
BOT_MODE=webhook
WEBHOOK_BASE_URL=https://yourdomain.com
WEBHOOK_PATH=/webhook/bot

# ===== Cloudflare Turnstile =====
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_TTL_DAYS=30

# ===== Media Cache =====
MEDIA_CACHE_TTL_DAYS=7
MEDIA_CACHE_DIR=/app/media

# ===== Initial Admin Account =====
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change_me_initial_password

# ===== Caddy (optional, used in Caddyfile) =====
SITE_ADDRESS=yourdomain.com

# ===== AI (optional) =====
# Supported providers: openai, anthropic, ollama, coze, custom
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o-mini

# ===== Ollama (local AI, optional) =====
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ===== Coze (扣子, optional) =====
# COZE_API_KEY=your_coze_api_key
# COZE_BOT_ID=your_coze_bot_id

# ===== RAG (optional, requires Dify or other provider) =====
# RAG_PROVIDER=dify
# DIFY_BASE_URL=http://docker-api-1:5001/v1
# DIFY_API_KEY=dataset-xxxxxxxxxxxxxxxx
# DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RAG_TOP_K=3

# ===== Agent System =====
# Agent default model (used when agent doesn't specify one)
# AGENT_DEFAULT_MODEL=gpt-4o-mini
# Agent max history messages to include in context
# AGENT_MAX_HISTORY=20

# ===== Bot Source Code Management =====
# Directory for generated bot source files
# BOT_SOURCE_DIR=/app/bot_sources
# Enable local bot execution (security risk, use with caution)
# BOT_LOCAL_EXECUTION=false

# ===== Scheduled Tasks =====
# Enable task scheduler
# TASK_SCHEDULER_ENABLED=true
# Task timezone
# TASK_SCHEDULER_TIMEZONE=UTC
